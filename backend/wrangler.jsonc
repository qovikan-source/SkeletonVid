{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skeletonvid-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skeletonvid-db",
      "database_id": "skeletonvid-db-local"
    }
  ],
  "vars": {
    "APP_URL": "https://SkeletonVid.pro"
  }
}
